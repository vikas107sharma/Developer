✅✅ Middleware ✅✅

Sits between request/ response cycle

1. Security: Verify credentials, Rate limit
2. Logging and Monitoring
3. Global error handling: Something went wrong (Proper structured error message) -> Kept as last middleware 
4. Compression: Large response (JSON) -> compress it
5. Data parsing: Serialization and deserialization

Request Context (Only limited to that particular request) 
Middleware set some context to given request (userId, Role, Permission)


✅✅ Before request/ After request ✅✅

import time
import logging
from flask import Flask, request, g

app = Flask(__name__)

# Standard Python logger (use structured JSON logging in real production)
logging.basicConfig(level=logging.INFO, format='%(message)s')
logger = logging.getLogger("api_logger")

@app.before_request
def log_request():
    """Executes before the route handler."""
    # time.perf_counter is more accurate than time.time for benchmarking
    g.start_time = time.perf_counter() 
    
    # Be cautious logging request.get_json() directly to avoid PII leaks
    logger.info(f"[REQ] {request.method} {request.path} | IP: {request.remote_addr}")

@app.after_request
def log_response(response):
    """Executes after the route handler successfully returns."""
    start_time = getattr(g, 'start_time', None)
    elapsed_ms = (time.perf_counter() - start_time) * 1000 if start_time else 0

    logger.info(
        f"[RES] {request.method} {request.path} | "
        f"Status: {response.status_code} | "
        f"Time: {elapsed_ms:.2f}ms | "
        f"Length: {response.content_length or 0} bytes"
    )
    
    # You MUST return the response object in after_request
    return response

# --- Edge Case Handling ---

@app.teardown_request
def log_exception(exception=None):
    """Executes even if an unhandled exception crashes the route."""
    if exception:
        logger.error(f"[ERROR] {request.method} {request.path} | Exception: {str(exception)}")


@app.route('/api/test', methods=['GET'])
def test_route():
    # Simulate work
    time.sleep(0.1) 
    return {"message": "Success"}, 200

if __name__ == '__main__':
    app.run(port=5000)


✅✅ Decorator ✅✅

import time
import logging
from functools import wraps
from flask import request, current_app

# Setup basic logger (use JSON logging in production)
logging.basicConfig(level=logging.INFO, format='%(message)s')
logger = logging.getLogger("api_logger")

def log_request_response(f):
    """
    A single-block decorator that logs the request, executes the route, 
    and logs the response (along with execution time).
    """
    @wraps(f) # CRITICAL: Preserves the original function name for Flask routing
    def decorated_function(*args, **kwargs):
        # ==========================================
        # 1. REQUEST PHASE
        # ==========================================
        start_time = time.perf_counter()
        logger.info(f"[REQ] {request.method} {request.path} | IP: {request.remote_addr}")

        # ==========================================
        # 2. CONTROLLER EXECUTION
        # ==========================================
        try:
            # Yield to the actual route handler
            rv = f(*args, **kwargs)
        except Exception as e:
            # Catch unhandled crashes inside the route
            elapsed_ms = (time.perf_counter() - start_time) * 1000
            logger.error(f"[ERROR] {request.method} {request.path} | Time: {elapsed_ms:.2f}ms | Exception: {str(e)}")
            raise # Re-raise so Flask's global 500 handler can process it

        # ==========================================
        # 3. RESPONSE PHASE
        # ==========================================
        # Flask routes can return strings, dicts, or tuples (e.g., `{"msg": "ok"}, 200`).
        # We must convert it to an actual Response object to safely read the status_code.
        response = current_app.make_response(rv)
        
        elapsed_ms = (time.perf_counter() - start_time) * 1000
        
        logger.info(
            f"[RES] {request.method} {request.path} | "
            f"Status: {response.status_code} | "
            f"Time: {elapsed_ms:.2f}ms"
        )

        return response
        
    return decorated_function


from flask import Flask

app = Flask(__name__)

@app.route('/api/users', methods=['GET'])
@log_request_response  # <--- Applied here
def get_users():
    time.sleep(0.05) # Simulate DB call
    
    # Notice we return a tuple. current_app.make_response handles this safely.
    return {"users": [{"id": 1, "name": "Alice"}]}, 200

if __name__ == '__main__':
    app.run(port=5000)